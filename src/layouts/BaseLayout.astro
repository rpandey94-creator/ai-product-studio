---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = Astro.url.pathname } = Astro.props;
const nav = [
  ['/catalog/', 'Product field', 'Products'],
  ['/simulations/', 'Simulations', 'Simulations'],
  ['/architecture/', 'Architecture', 'Systems'],
  ['/frameworks/', 'Atlas', 'Atlas'],
  ['/workbench/', 'Evaluation lab', 'Eval'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07100e" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <title>{title} · AI Product Engineering Lab</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ambient-grid" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="AI Product Engineering Lab home">
        <span class="brand-mark" aria-hidden="true">A/27</span>
        <span>Product Engineering Lab</span>
      </a>
      <nav aria-label="Primary navigation">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="source-link" href="https://github.com/rpandey94-creator/ai-product-studio/tree/astro-immersive-migration">Source ↗</a>
    </header>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {nav.map(([href, , mobileLabel]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{mobileLabel}</a>)}
    </nav>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <p class="eyebrow">Build ledger</p>
        <strong>AI Product Engineering Lab / 2027</strong>
      </div>
      <p>Research candidates are not shipped products. Simulations are labeled. Working software links to source and evidence.</p>
      <a href="https://github.com/rpandey94-creator/ai-product-studio">GitHub repository ↗</a>
    </footer>
  </body>
</html>
