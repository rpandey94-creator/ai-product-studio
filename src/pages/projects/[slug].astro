---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ArchitectureExplorer from '../../components/ArchitectureExplorer';
import EconomicsLab from '../../components/EconomicsLab';
import FeedbackLab from '../../components/FeedbackLab';
import KnowledgeLab from '../../components/KnowledgeLab';
import VoiceLab from '../../components/VoiceLab';
import DocumentLab from '../../components/DocumentLab';
import WorkbenchDemo from '../../components/WorkbenchDemo';
import reportSource from '../../../evidence/evaluation-workbench-report.json';
import fixtures from '../../../apps/evaluation-workbench/data/synthetic_cases.json';
import { portfolioProjects, type PortfolioProject } from '../../data/portfolio';

export function getStaticPaths() { return portfolioProjects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props as { project: PortfolioProject };
const tone = project.status === 'Locally Implemented and Tested' || project.status === 'Public Live Demo' ? 'working' : project.status === 'Interactive UX Prototype' ? 'simulation' : 'roadmap';
const responses = new Map(fixtures.map((fixture) => [fixture.id, fixture.response]));
const report = { ...reportSource, results: reportSource.results.map((result) => ({ ...result, response: responses.get(result.case_id) ?? 'Fixture response unavailable.' })) };
const architecture = [{ name: project.title, status: project.architecture.some((item)=>item.status==='Integrated and tested') ? 'Mixed system: tested browser/local layers plus labeled proposed components' : 'Proposed architecture', nodes: project.architecture, edges: project.edges }];
---
<BaseLayout title={project.title} description={project.oneLine}>
  <header class={`case-hero case-${project.visual}`}><div class="shell case-hero-grid"><div><p class="eyebrow">Project {project.number} · {project.category}{project.flagship ? ' · Flagship' : ''}</p><span class={`tag ${tone}`}>{project.status}</span><h1 class="display">{project.title}</h1><p class="lead">{project.oneLine}</p><div class="button-row"><a class="button primary" href="#product">Product case</a><a class="button" href="#architecture">Architecture</a><a class="button" href="#economics">Economics</a></div></div><ProjectVisual project={project} /></div></header>

  <nav class="case-nav shell" aria-label="Case study sections"><a href="#product">Product</a><a href="#prototype">Prototype</a><a href="#strategy">Strategy</a><a href="#architecture">Architecture</a><a href="#evaluation">Evaluation</a><a href="#economics">Economics</a><a href="#blueprint">Blueprint</a></nav>
  <section class="section-tight shell claim-banner"><span class={`tag ${tone}`}>{project.status}</span><p>{project.status === 'Locally Implemented and Tested' ? 'Executable local source, generated evidence, and automated tests are present. Proposed telemetry integrations remain separately labeled.' : project.status === 'Interactive UX Prototype' ? 'The browser interaction uses synthetic, illustrative data. It validates product states and decisions—not a live AI backend, customer result, or production integration.' : 'This is a designed product case study. Architecture, targets, and economics are proposals or modeled assumptions unless explicitly labeled otherwise.'}</p></section>

  <section class="section shell case-overview" id="product"><div class="case-intro"><p class="eyebrow">01 · Market and problem</p><h2 class="section-title">Start with the buyer, workflow and failure cost.</h2></div><div class="overview-grid"><article><h3>Buyer / user</h3><p><strong>{project.buyer}</strong><br/>{project.targetUser}</p></article><article><h3>Market context</h3><p>{project.market}</p></article><article><h3>Customer problem</h3><p>{project.problem}</p></article><article><h3>Why now / product thesis</h3><p>{project.whyNow}</p></article><article><h3>Current alternatives</h3><ul>{project.alternatives?.map((item)=><li>{item}</li>)}</ul></article><article><h3>Validation plan</h3><ul>{project.validation?.map((item)=><li>{item}</li>)}</ul></article></div></section>

  <section class="section prototype-band shell" id="prototype"><div class="section-heading"><div><p class="eyebrow">02 · Product interaction</p><h2>{project.status === 'Interactive UX Prototype' || project.status === 'Locally Implemented and Tested' ? 'Exercise the decision, not a decorative mockup.' : 'The intended interaction and build boundary.'}</h2></div><p>Every interactive surface identifies synthetic inputs and avoids implying an unimplemented model or integration.</p></div>
    {project.slug === 'customer-feedback-intelligence' && <FeedbackLab client:load />}
    {project.slug === 'permission-aware-knowledge-assistant' && <KnowledgeLab client:load />}
    {project.slug === 'ai-reliability-observability-studio' && <WorkbenchDemo report={report} client:load />}
    {project.slug === 'real-time-multimodal-assistant' && <VoiceLab client:load />}
    {project.slug === 'document-intelligence-approval' && <DocumentLab client:load />}
    {!['customer-feedback-intelligence','permission-aware-knowledge-assistant','ai-reliability-observability-studio','real-time-multimodal-assistant','document-intelligence-approval'].includes(project.slug) && <div class="interaction-blueprint"><div><span>INPUT</span><strong>{project.journey[0]}</strong></div><div><span>DECISION LOOP</span><strong>{project.journey.slice(1,-1).join(' → ')}</strong></div><div><span>ACCOUNTABLE OUTCOME</span><strong>{project.journey.at(-1)}</strong></div><p>This case does not claim a working browser product. The interaction blueprint defines the next testable slice.</p></div>}
  </section>

  <section class="section shell" id="strategy"><div class="section-heading"><div><p class="eyebrow">03 · Strategy and requirements</p><h2>Jobs, scope and adoption are explicit.</h2></div><p>The MVP proves the riskiest workflow assumption while high-cost integrations remain deferred.</p></div><div class="strategy-board"><article><h3>Jobs to be done</h3><ol>{project.jobs.map((item)=><li>{item}</li>)}</ol></article><article><h3>Product goals</h3><ul>{project.goals.map((item)=><li>{item}</li>)}</ul></article><article><h3>MVP — now</h3><ul>{project.mvp.map((item)=><li>{item}</li>)}</ul></article><article><h3>Later</h3><ul>{project.later.map((item)=><li>{item}</li>)}</ul></article><article><h3>Functional requirements</h3><ul>{project.functionalRequirements?.map((item)=><li>{item}</li>)}</ul></article><article><h3>Non-functional requirements</h3><ul>{project.nonFunctionalRequirements?.map((item)=><li>{item}</li>)}</ul></article><article><h3>Adoption strategy</h3><ul>{project.adoption?.map((item)=><li>{item}</li>)}</ul></article><article><h3>Discovery discipline</h3><ul>{project.discovery.map((item)=><li>{item}</li>)}</ul></article></div><div class="metric-cards">{project.metrics.map((metric)=><div><span class={`metric-kind ${metric.kind}`}>{metric.kind.replaceAll('-',' ')}</span><strong>{metric.target}</strong><small>{metric.label}</small><p>{metric.note}</p></div>)}</div></section>

  <section class="section shell journey-section"><p class="eyebrow">04 · Journey and failure modes</p><h2 class="section-title">Intent becomes an accountable outcome.</h2><ol class="journey-line">{project.journey.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><strong>{item}</strong></li>)}</ol><div class="edge-grid"><article><h3>Relevant edge cases</h3><ul>{project.edgeCases.map((item)=><li>{item}</li>)}</ul></article><article><h3>Failure and risk register</h3><ul>{project.risks.map((item)=><li>{item}</li>)}</ul></article></div></section>

  <section class="section architecture-band" id="architecture"><div class="shell"><div class="section-heading"><div><p class="eyebrow">05 · System architecture</p><h2>Inspect every component boundary.</h2></div><p>Each component documents technology, rationale, alternatives, contracts, dependencies, failure modes, cost posture, and maturity.</p></div><ArchitectureExplorer architectures={architecture} client:visible /><h3 class="subsection-title">Technology decisions</h3><div class="stack-decisions">{project.stack.map((item)=><article><span class="stack-status">{item.status}</span><h3>{item.name}</h3><p><strong>{item.role}</strong></p><p>{item.reason}</p><details><summary>Decision evidence</summary><p><strong>Alternative:</strong> {item.alternatives}</p><p><strong>Evidence:</strong> {item.evidence}</p></details></article>)}</div></div></section>

  <section class="section shell" id="evaluation"><div class="section-heading"><div><p class="eyebrow">06 · Evaluation and evidence</p><h2>Quality gates before success claims.</h2></div><p>Measured results appear only for executable evidence. Targets, synthetic scenarios, modeled assumptions, and external facts remain visually distinct.</p></div><div class="evaluation-grid"><article><h3>Evaluation plan</h3><ul>{project.evaluation.map((item)=><li>{item}</li>)}</ul></article><article><h3>Evidence available today</h3><ul>{project.evidence.map((item)=><li>{item}</li>)}</ul></article><article><h3>Primary-source research</h3><ul>{project.sources?.map((item)=><li><a href={item.url}>{item.label} ↗</a><br/><small>{item.note}</small></li>)}</ul></article></div></section>

  <section class="section shell" id="economics"><div class="section-heading"><div><p class="eyebrow">07 · Unit economics</p><h2>Edit the assumptions; do not confuse the output with evidence.</h2></div><p>Formulas are product-specific. Values are planning inputs until real usage and vendor costs are recorded.</p></div>{project.economics && <EconomicsLab economics={project.economics} slug={project.slug} client:visible />}</section>

  <section class="section shell"><div class="section-heading"><div><p class="eyebrow">08 · Decisions</p><h2>Tradeoffs are part of the artifact.</h2></div></div><div class="decision-records">{project.decisions?.map((item)=><article><h3>{item.decision}</h3><p>{item.rationale}</p><small>Rejected: {item.rejected}</small></article>)}</div></section>

  <section class="section-tight shell next-build" id="blueprint"><div><p class="eyebrow">09 · Engineering blueprint</p><h2>{project.status === 'Locally Implemented and Tested' ? 'Inspect the verified slice and its next boundary.' : 'Build the next slice from an explicit contract.'}</h2><ol>{project.next.map((item)=><li>{item}</li>)}</ol><p class="blueprint-path">{project.blueprint}</p></div><div class="button-row">{project.demo && <a class="button primary" href={project.demo}>Open working interface</a>}{project.source && <a class="button" href={project.source}>Inspect source ↗</a>}<a class="button" href={`https://github.com/rpandey94-creator/ai-product-studio/tree/personal-ai-pm-portfolio/${project.blueprint}`}>Open blueprint ↗</a></div></section>
</BaseLayout>
