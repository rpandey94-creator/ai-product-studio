---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NarrativeMotion from '../../components/NarrativeMotion';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { portfolioProjects } from '../../data/portfolio';
const groups = ['AI Product Management','AI Engineering Depth','Forward-Deployed AI'] as const;
const tone = (status: string) => status === 'Locally Implemented and Tested' || status === 'Public Live Demo' ? 'working' : status === 'Interactive UX Prototype' ? 'simulation' : 'roadmap';
---
<BaseLayout title="Independent AI Product Projects" description="Thirteen independent AI product case studies across product management, engineering depth, and forward-deployed enterprise systems.">
  <NarrativeMotion client:idle />
  <header class="page-hero shell"><p class="eyebrow">Independent work · no employer or client projects</p><h1 class="display">Products selected for <em>learning, value and proof.</em></h1><p class="lead">Five AI PM cases, four engineering-depth systems, and four forward-deployed workflows. Four receive flagship depth; every case separates executed evidence from synthetic scenarios, targets, assumptions, and research.</p></header>
  <section class="section-tight shell"><div class="status-legend"><span class="tag roadmap">Product Case Study — Designed</span><span class="tag simulation">Interactive UX Prototype</span><span class="tag working">Locally Implemented and Tested</span><span class="tag">Public Live Demo only after verification</span></div></section>
  {groups.map((group) => <section class="section shell project-group"><div class="section-heading" data-reveal><div><p class="eyebrow">{group}</p><h2>{group === 'AI Product Management' ? 'Problem selection and product judgment.' : group === 'AI Engineering Depth' ? 'Systems that make technical tradeoffs visible.' : 'Enterprise workflows built around integration and accountability.'}</h2></div><p>{group === 'AI Product Management' ? 'Buyer, workflow, evidence, requirements, adoption and value are defined before model selection.' : group === 'AI Engineering Depth' ? 'Local inference, evaluation, fine-tuning, and realtime systems are evaluated through explicit constraints.' : 'Every enterprise workflow includes permissions, exceptions, approvals, auditability, and rollback.'}</p></div><div class="portfolio-grid">{portfolioProjects.filter((project)=>project.category===group).map((project)=><article class="portfolio-card" data-reveal><ProjectVisual project={project} compact /><div class="portfolio-card-copy"><div class="card-kicker"><span>{project.number}{project.flagship ? ' · Flagship' : ''}</span><span class={`tag ${tone(project.status)}`}>{project.status}</span></div><h3>{project.title}</h3><p>{project.oneLine}</p><div class="card-meta"><span>{project.targetUser}</span><span>{project.stack.filter(item=>item.status==='Integrated and tested').length ? `${project.stack.filter(item=>item.status==='Integrated and tested').length} tested layers` : 'Architecture proposed'}</span></div><a href={`/projects/${project.slug}/`}>Explore product, architecture and economics →</a></div></article>)}</div></section>)}
  <section class="section-tight shell archive-callout"><p><strong>Supporting research preserved.</strong> The earlier 64-candidate research catalog and 63-framework atlas remain available as secondary evidence, not the portfolio’s primary story.</p><div class="button-row"><a class="button" href="/research/">Open research archive</a></div></section>
</BaseLayout>

