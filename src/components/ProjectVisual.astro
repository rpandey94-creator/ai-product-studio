---
import type { PortfolioProject } from '../data/portfolio';
const { project, compact = false } = Astro.props as { project: PortfolioProject; compact?: boolean };
const bars = project.visual === 'inventory' ? [42, 68, 55, 81, 61, 73] : project.visual === 'reliability' ? [92, 74, 88, 51, 79, 64] : [32, 54, 77, 62, 85, 70];
---
<div class:list={['project-visual', `visual-${project.visual}`, compact && 'is-compact']} aria-label={`${project.title} interface concept`}>
  <div class="visual-topbar"><span></span><strong>{project.title}</strong><small>{project.status}</small></div>
  {project.visual === 'feedback' && <div class="feedback-ui"><aside><b>Signal inbox</b><span class="active">Login friction <i>42</i></span><span>Reporting gaps <i>31</i></span><span>Mobile setup <i>18</i></span></aside><section><div class="chart-title"><b>Theme momentum</b><small>synthetic feedback</small></div><div class="sparkline"><svg viewBox="0 0 300 90" role="img" aria-label="Synthetic theme trend"><path d="M0 72 C45 68 58 42 92 48 S140 70 164 40 S230 42 300 8" fill="none" stroke="currentColor" stroke-width="4"/><path d="M0 72 C45 68 58 42 92 48 S140 70 164 40 S230 42 300 8 L300 90 L0 90Z" fill="currentColor" opacity=".08"/></svg></div><div class="quote-row"><span>“Reset looped twice”</span><span>“Couldn’t invite my team”</span></div></section></div>}
  {project.visual === 'knowledge' && <div class="knowledge-ui"><div class="search-box">How do contractors request production access?<kbd>⌘K</kbd></div><div class="answer-panel"><div class="access-line"><span class="access-dot"></span> Authorized sources only</div><h4>Production access requires an owner, expiry date, and security review.</h4><p><mark>[1]</mark> Access policy v4.2 · section 3.1</p><p><mark>[2]</mark> Contractor controls · updated 12 Oct</p></div><aside class="source-stack"><b>Retrieved evidence</b><span>Access policy <i>96%</i></span><span>Contractor controls <i>91%</i></span><span class="denied">Finance handbook · denied</span></aside></div>}
  {project.visual === 'document' && <div class="document-ui"><div class="document-sheet"><span>INVOICE</span><i></i><i></i><i class="short"></i><strong>₹ 48,250</strong></div><div class="extraction-panel"><b>Extracted fields</b><label>Vendor <span>Northstar Labs</span><em>98%</em></label><label>Total <span>₹ 48,250</span><em>99%</em></label><label class="warning">PO number <span>Missing</span><em>Review</em></label><button type="button">Send to reviewer</button></div></div>}
  {project.visual === 'multimodal' && <div class="multimodal-ui"><div class="camera-frame"><div class="focus-box"><span>pressure gauge</span></div><small>VISION · 0.81 confidence</small></div><div class="wave-column"><div class="wave">{Array.from({length:18}).map((_,i)=><i style={`--h:${18 + (i*17)%48}px`}></i>)}</div><p>“The reading is outside the normal range. Shall I open the safety checklist?”</p><div class="latency-row"><span>STT 184ms</span><span>Reason 312ms</span><span>TTS 221ms</span></div></div></div>}
  {project.visual === 'pm' && <div class="pm-ui"><div class="meeting-card"><b>Discovery sync</b><span>3 decisions</span><span>5 actions</span><span>2 open risks</span></div><div class="approval-list"><label><input type="checkbox" checked disabled/> Validate onboarding metric <em>Rishav</em></label><label><input type="checkbox" disabled/> Draft experiment brief <em>Needs owner</em></label><label><input type="checkbox" checked disabled/> Share research summary <em>Approved</em></label></div></div>}
  {!['feedback','knowledge','document','multimodal','pm'].includes(project.visual) && <div class="metric-ui"><div class="metric-dial"><span>{project.visual === 'reliability' ? '75' : project.visual === 'inventory' ? '±18' : '13'}</span><small>{project.visual === 'reliability' ? 'avg score' : project.visual === 'inventory' ? 'forecast range' : 'decision signals'}</small></div><div class="bar-stack">{bars.map((bar,index)=><div><span>{['Quality','Latency','Safety','Coverage','Cost','Recovery'][index]}</span><i><b style={`width:${bar}%`}></b></i><em>{bar}</em></div>)}</div></div>}
</div>

